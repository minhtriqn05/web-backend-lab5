PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/lab5_shopadmin

# JWT - use a long random string
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Google Sign-In: OAuth Client ID from Google Cloud Console (same value as GOOGLE_CLIENT_ID in frontend/config.js)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Gmail SMTP: your Gmail address + a 16-character App Password (2-Step Verification must be on)
GMAIL_USER=your-shop@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop

# Cron schedules (leave empty for production values). For testing use '* * * * *' (every minute)
INVENTORY_REPORT_CRON=
ARCHIVE_CRON=
ARCHIVE_AFTER_MINUTES=
REVENUE_REPORT_CRON=

# Optional: comma-separated list of allowed Web UI origins (default: any origin)
# CLIENT_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
